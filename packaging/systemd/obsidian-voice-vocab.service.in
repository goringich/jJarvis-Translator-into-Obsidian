[Unit]
Description=Obsidian voice vocabulary wake-word daemon
Documentation=file://@PROJECT_DIR@/README.md
After=default.target sound.target pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/.venv/bin/obsidian-voice-vocab --config @CONFIG_PATH@ daemon
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

